{
    "name": "vacastream",
    "version": "1.0.0",
    "description": "Vacation streaming service",
    "private": true,
    "scripts": {
        "dev": "pnpm -r --parallel --if-present run dev",
        "build": "pnpm -r run build",
        "start": "pnpm --filter \"@yd/*\" -r run build && pnpm -r --parallel --if-present run start",
        "test": "vitest run",
        "lint": "eslint . && pnpm --filter vacastream-web-app run lint"
    },
    "author": "Yuval Dromi",
    "license": "ISC",
    "packageManager": "pnpm@10.28.0",
    "devDependencies": {
        "@eslint/js": "^9.39.2",
        "bcryptjs": "^2.4.3",
        "eslint": "^9.39.2",
        "globals": "^16.5.0",
        "typescript-eslint": "^8.54.0",
        "vitest": "^3.2.7"
    }
}
